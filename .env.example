# --- Vault location ---
# Absolute path to the Obsidian vault directory.
VAULT_PATH=/absolute/path/to/your/Obsidian/Vault
# Optional: vault-relative dirs (auto-detected from names if left empty).
OBSIDIAN_TEMPLATES_DIR=
OBSIDIAN_DAILY_DIR=
# Embedding model for semantic search (needs OPENAI_API_KEY).
OBSIDIAN_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM providers ---
# Vercel AI Gateway (preferred for UI)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Direct providers for LangChain agents (only what you plan to use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default chat model for agents (LangChain init_chat_model spec)
AGENT_MODEL=openai:gpt-5.4-mini

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vault-mcp

# --- MCP server auth (single-user) ---
# Required to expose the HTTP/SSE transport on a network. Send as
# `Authorization: Bearer <token>`. stdio (Claude Code/Desktop) ignores this.
MCP_STATIC_TOKEN=
MCP_USER_EMAIL=
MCP_USER_NAME=

# --- Server ---
LOG_LEVEL=INFO
LOG_FORMAT=json
PORT=8000

# URL of the MCP server seen from the agents/API process.
MCP_URL=http://127.0.0.1:8000/mcp

# --- API auth (set before any public deploy) ---
# Protects /api/chat and /api/agent (Bearer token). Left empty = open (dev only).
API_SECRET=
# Protects /api/cron/organize. Vercel sets this automatically for cron.
CRON_SECRET=
